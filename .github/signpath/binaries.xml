<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "binaries" (paste it into the SignPath
     project under that slug): the app and its uninstaller, in the zip the
     release workflow's first build hands out. Both must say they're Thought
     Desk at the version being released. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="thought-desk.exe" product-name="Thought Desk" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="uninstall.exe" product-name="Thought Desk" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
