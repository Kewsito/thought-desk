<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer" (paste it into the SignPath
     project under that slug): the installer the release workflow's second
     build makes around the signed app and uninstaller. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Thought Desk_${version}_x64-setup.exe" product-name="Thought Desk" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
